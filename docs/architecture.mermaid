flowchart TB
    caller([Caller on phone])

    subgraph voice["Voice loop"]
        stt[Gradium STT]
        tts[Gradium TTS]
    end

    subgraph brain["Agent core"]
        gemini[GeminiBrain<br/>Gemini 2.5 Flash<br/>+ fallback chain]
        ctx[Known-context CRM<br/>injection]
    end

    subgraph tools["Tools (function-calling)"]
        tavily[Tavily real-time lookup]
        coverage[[coverage_lookup]]
    end

    subgraph retrieval["Retrieval"]
        corpus[(Policy + regulation<br/>corpus)]
        chunker[Structure-aware chunker]
        embedder[Embedder<br/>BGE-M3 multilingual]
        qdrant[(Qdrant<br/>named vectors emb_v1 / emb_v2)]
        retr[Retriever]
        noop[Recall order<br/>no rerank — live path]
        migrate{{Migration<br/>introduce, dual-write, backfill,<br/>shadow-eval, cutover, rollback}}
    end

    subgraph extract["Extraction"]
        gliner[GLiNER2 extractor]
        pillars[15 claim pillars<br/>+ 5 fraud signals]
    end

    subgraph llmops["LLMOps"]
        registry[Prompt registry<br/>versioned + content-hashed]
        logmw[Trace logging<br/>PII-redacted]
        judge[LLM-as-judge<br/>groundedness]
        drift[Drift monitor<br/>groundedness + PSI]
        gate[CI eval gate<br/>blocks regressions]
        rerank[Cross-encoder rerank<br/>bge-reranker-v2-m3<br/>evaluation only: ~2.8 s/query]
    end

    bridge[FastAPI WS bridge]
    dash[Dashboard]

    caller --> stt --> gemini
    ctx --> gemini
    gemini --> tts --> caller
    gemini <--> tavily
    gemini <--> coverage
    coverage --> retr
    corpus --> chunker --> embedder --> qdrant
    retr --> qdrant
    retr --> noop --> coverage
    migrate -. rewrites named vectors .-> qdrant
    registry --> gemini
    gemini --> logmw
    logmw --> judge --> drift
    retr --> logmw
    gemini -. transcript .-> gliner --> pillars --> bridge --> dash
    pillars --> logmw
    retr -. scored offline .-> rerank --> gate
    judge --> gate
    gate -. gates merges .-> registry
