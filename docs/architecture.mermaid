flowchart TB
    caller([Caller on phone])

    subgraph voice["Voice loop (existing)"]
        stt[Gradium STT]
        tts[Gradium TTS]
    end

    subgraph brain["Agent core (existing, extended)"]
        gemini[GeminiBrain<br/>Gemini 2.5 Flash<br/>+ fallback chain]
        ctx[Known-Context CRM<br/>injection]
    end

    subgraph tools["Tools (function-calling)"]
        tavily[Tavily real-time lookup]
        coverage[[coverage_lookup tool<br/>NEW]]
    end

    subgraph retrieval["Retrieval subsystem (NEW)"]
        corpus[(Policy + claims +<br/>regulation corpus)]
        chunker[Structure-aware chunker]
        embedder[Embedder<br/>BGE-M3 multilingual]
        qdrant[(Qdrant<br/>named vectors:<br/>v1 + v2 blue/green)]
        retr[Retriever]
        rerank[Cross-encoder rerank<br/>bge-reranker-v2-m3]
        migrate{{Migration job<br/>dual-write + backfill<br/>+ shadow-eval + swap}}
    end

    subgraph extract["Extraction (existing, extended)"]
        gliner[GLiNER2 extractor<br/>quantized for serving]
        pillars[15 claim pillars<br/>+ 5 fraud signals]
    end

    subgraph llmops["LLMOps (NEW)"]
        registry[Prompt registry<br/>versioned + hashed]
        logmw[Logging middleware<br/>PII-redacted traces]
        judge[LLM-as-judge<br/>groundedness]
        drift[Drift + hallucination<br/>monitor]
        gate[CI eval gate<br/>blocks regressions]
    end

    bridge[FastAPI WS bridge]
    dash[Dashboard]

    caller --> stt --> gemini
    ctx --> gemini
    gemini --> tts --> caller
    gemini <--> tavily
    gemini <--> coverage
    coverage --> retr
    corpus --> chunker --> embedder --> qdrant
    retr --> qdrant
    retr --> rerank --> coverage
    migrate -. reindex .-> qdrant
    registry --> gemini
    gemini --> logmw
    logmw --> judge --> drift
    retr --> logmw
    gemini -. transcript .-> gliner --> pillars --> bridge --> dash
    pillars --> logmw
    gate -. gates merges .-> registry
